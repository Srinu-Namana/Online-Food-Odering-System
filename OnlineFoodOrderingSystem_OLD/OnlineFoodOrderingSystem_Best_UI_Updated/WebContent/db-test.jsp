<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.food.util.DBConnection.Diagnostic" %>
<% Diagnostic d=(Diagnostic)request.getAttribute("diagnostic"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Database Test | Victo Food House</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link href="css/style.css" rel="stylesheet"></head>
<body><nav class="navbar bg-white border-bottom"><div class="container py-2"><a class="navbar-brand fw-bold" href="index.jsp">Victo<span class="brand-dot">.</span></a><a href="index.jsp" class="btn btn-outline-secondary rounded-pill">Home</a></div></nav>
<main class="container py-5"><div class="row justify-content-center"><div class="col-lg-8"><div class="dashboard-card p-4 p-md-5">
<div class="d-flex align-items-center gap-3 mb-4"><div class="icon-circle"><i class="bi bi-database-check"></i></div><div><h2 class="fw-bold mb-1">Database Connection Test</h2><p class="text-secondary mb-0">Automatic JDBC diagnostics for this application.</p></div></div>
<% if(d.isConnected()) { %><div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i><strong>Connected successfully.</strong> MySQL is reachable and the application can open a JDBC connection.</div><% } else { %><div class="alert alert-danger"><i class="bi bi-x-circle-fill me-2"></i><strong>Connection failed.</strong> The diagnostic below identifies the likely cause.</div><% } %>
<div class="row g-3"><div class="col-md-6"><div class="p-3 bg-light rounded-4"><small class="text-secondary">JDBC URL</small><div class="fw-semibold text-break"><%=d.getUrl()%></div></div></div><div class="col-md-6"><div class="p-3 bg-light rounded-4"><small class="text-secondary">Username</small><div class="fw-semibold"><%=d.getUser()%></div></div></div><div class="col-md-6"><div class="p-3 bg-light rounded-4"><small class="text-secondary">Database</small><div class="fw-semibold"><%=d.getDatabase()%></div></div></div><div class="col-md-6"><div class="p-3 bg-light rounded-4"><small class="text-secondary">MySQL Server</small><div class="fw-semibold"><%=d.getServer()%></div></div></div></div>
<hr class="my-4"><h5 class="fw-bold">Diagnostic</h5><p><span class="badge <%=d.isConnected()?"bg-success":"bg-danger"%>"><%=d.getCategory()%></span></p><div class="alert alert-light border"><%=d.getMessage()%></div>
<% if(!d.isConnected()) { %><h5 class="fw-bold mt-4">What to check</h5><ol class="text-secondary"><li>Start MySQL/XAMPP.</li><li>Verify MySQL is listening on port <strong>3306</strong>.</li><li>Open <code>src/com/food/util/DBConnection.java</code>.</li><li>Set the correct root username and password.</li><li>Run <code>database/food_ordering_db.sql</code> in MySQL.</li><li>Clean and restart the Tomcat server.</li></ol><% } %>
<div class="d-flex flex-wrap gap-2 mt-4"><a href="db-test" class="btn btn-primary rounded-pill px-4"><i class="bi bi-arrow-clockwise me-1"></i>Test Again</a><a href="login.jsp" class="btn btn-outline-secondary rounded-pill px-4">Go to Login</a></div>
</div></div></div></main></body></html>
